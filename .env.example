# Local Docker development defaults. Copy this file to .env.
BACKEND_SERVER_NAME=api.maxmetrics.local
FRONTEND_SERVER_NAME=www.maxmetrics.local

APP_SECRET=change-this-local-app-secret
JWT_SECRET=change-this-local-jwt-secret

POSTGRES_DB=maxmetrics
POSTGRES_USER=maxmetrics
POSTGRES_PASSWORD=change-this-local-database-password
POSTGRES_VERSION=18
